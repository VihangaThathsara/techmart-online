<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>lk.jiat</groupId>
        <artifactId>techmart-modernization</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>techmart-ear</artifactId>
    <packaging>ear</packaging>

    <dependencies>
        <dependency>
            <groupId>lk.jiat</groupId>
            <artifactId>techmart-common</artifactId>
            <version>${project.version}</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>lk.jiat</groupId>
            <artifactId>techmart-ejb</artifactId>
            <version>${project.version}</version>
            <type>ejb</type>
        </dependency>
        <dependency>
            <groupId>lk.jiat</groupId>
            <artifactId>techmart-web</artifactId>
            <version>${project.version}</version>
            <type>war</type>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
            <type>jar</type>
        </dependency>
    </dependencies>

    <build>
        <finalName>techmart-modernization</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <version>10</version>
                    <!-- Let Maven generate application.xml so module names always match the files inside the EAR. -->
                    <generateApplicationXml>true</generateApplicationXml>
                    <defaultLibBundleDir>lib</defaultLibBundleDir>
                    <modules>
                        <jarModule>
                            <groupId>lk.jiat</groupId>
                            <artifactId>techmart-common</artifactId>
                            <bundleDir>lib</bundleDir>
                            <bundleFileName>techmart-common.jar</bundleFileName>
                        </jarModule>
                        <ejbModule>
                            <groupId>lk.jiat</groupId>
                            <artifactId>techmart-ejb</artifactId>
                            <bundleFileName>techmart-ejb.jar</bundleFileName>
                        </ejbModule>
                        <webModule>
                            <groupId>lk.jiat</groupId>
                            <artifactId>techmart-web</artifactId>
                            <bundleFileName>techmart-web.war</bundleFileName>
                            <contextRoot>/techmart</contextRoot>
                        </webModule>
                        <jarModule>
                            <groupId>com.mysql</groupId>
                            <artifactId>mysql-connector-j</artifactId>
                            <bundleDir>lib</bundleDir>
                            <bundleFileName>mysql-connector-j.jar</bundleFileName>
                        </jarModule>
                    </modules>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
